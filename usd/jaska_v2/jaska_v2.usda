        def OmniGraph "LidarPublisher"
        {
            token evaluationMode = "Automatic"
            token evaluator:type = "execution"
            token fabricCacheBacking = "Shared"
            int2 fileFormatVersion = (1, 9)
            token pipelineStage = "pipelineStageSimulation"

            def OmniGraphNode "ros2_context" (
                apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                custom uchar inputs:domain_id
                custom bool inputs:useDomainIDEnvVar
                token node:type = "isaacsim.ros2.bridge.ROS2Context"
                int node:typeVersion = 2
                custom uint64 outputs:context
                uniform float2 ui:nodegraph:node:pos = (0, 0)
            }

            def OmniGraphNode "on_playback_tick" (
                apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                token node:type = "omni.graph.action.OnPlaybackTick"
                int node:typeVersion = 2
                custom double outputs:deltaSeconds
                custom double outputs:frame
                custom uint outputs:tick (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom double outputs:time
                uniform float2 ui:nodegraph:node:pos = (0, 150)
            }

            # Fires once at startup to create the render product for the RTX lidar.
            # Required in IS 5.0+: render product must be created dynamically at runtime,
            # not as a static USD prim.
            def OmniGraphNode "run_one_sim_frame" (
                apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                uint inputs:execIn.connect = </jaska_v2/ActionGraph/LidarPublisher/on_playback_tick.outputs:tick>
                token node:type = "isaacsim.core.nodes.OgnIsaacRunOneSimulationFrame"
                int node:typeVersion = 1
                custom uint outputs:step (
                    customData = {
                        bool isExecution = 1
                    }
                )
                uniform float2 ui:nodegraph:node:pos = (300, 0)
            }

            # Creates the render product from the OmniLidar prim.
            # Output renderProductPath is passed to the RTX lidar helper each tick.
            def OmniGraphNode "create_render_product" (
                apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                custom rel inputs:cameraPrim = </jaska_v2/unitree_lidar_link/UnitreeL2> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom bool inputs:enabled = 1
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                uint inputs:execIn.connect = </jaska_v2/ActionGraph/LidarPublisher/run_one_sim_frame.outputs:step>
                custom uint inputs:height = 1
                custom uint inputs:width = 1
                token node:type = "isaacsim.core.nodes.IsaacCreateRenderProduct"
                int node:typeVersion = 2
                custom uint outputs:execOut (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom token outputs:renderProductPath
                uniform float2 ui:nodegraph:node:pos = (600, 0)
            }

            def OmniGraphNode "rtx_lidar_helper" (
                apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                custom uint64 inputs:context
                uint64 inputs:context.connect = </jaska_v2/ActionGraph/LidarPublisher/ros2_context.outputs:context>
                custom bool inputs:enabled = 1
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                uint inputs:execIn.connect = </jaska_v2/ActionGraph/LidarPublisher/on_playback_tick.outputs:tick>
                custom string inputs:frameId = "unilidar_lidar"
                custom uint inputs:frameSkipCount
                custom bool inputs:fullScan = 1
                custom string inputs:nodeNamespace = ""
                custom string inputs:qosProfile = ""
                custom uint64 inputs:queueSize = 10
                custom token inputs:renderProductPath
                token inputs:renderProductPath.connect = </jaska_v2/ActionGraph/LidarPublisher/create_render_product.outputs:renderProductPath>
                custom bool inputs:resetSimulationTimeOnStop = 0
                custom bool inputs:showDebugView
                custom string inputs:topicName = "unilidar/cloud"
                custom token inputs:type = "point_cloud" (
                    allowedTokens = ["laser_scan", "point_cloud"]
                )
                custom bool inputs:useSystemTime = 0
                token node:type = "isaacsim.ros2.bridge.ROS2RtxLidarHelper"
                int node:typeVersion = 1
                uniform float2 ui:nodegraph:node:pos = (900, 100)
            }
        }

