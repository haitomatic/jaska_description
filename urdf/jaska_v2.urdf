  <!-- Sensor: lidar_and_camera_mount_link -->
  <link name="lidar_and_camera_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://jaska_description/meshes/jaska_v2/sensors/lidar_and_camera_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mount_aluminum">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
