  </joint>

  <!-- Sensor: unitree_lidar_link -->
  <link name="unitree_lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://jaska_description/meshes/jaska_v2/sensors/unitree_l2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="lidar_sensor">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://jaska_description/meshes/jaska_v2/sensors/unitree_l2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
